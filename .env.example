# Copy to .env, replace every CHANGE_ME value, then run: docker compose up -d --build
APP_NAME=Mosaic Budget
APP_PORT=8080
APP_TIMEZONE=America/New_York
# In production, list the exact public hostname and enable secure cookies.
TRUSTED_HOSTS=*
COOKIE_SECURE=false
# Comma-separated proxy IPs allowed to set X-Forwarded-* headers. Use * only
# behind a firewall that prevents direct access to the application port.
FORWARDED_ALLOW_IPS=127.0.0.1

POSTGRES_DB=mosaic
POSTGRES_USER=mosaic
POSTGRES_PASSWORD=CHANGE_ME_DATABASE_PASSWORD

# Generate with ./scripts/generate-secrets.sh
APP_SECRET_KEY=CHANGE_ME_LONG_RANDOM_SECRET
APP_ENCRYPTION_KEY=CHANGE_ME_FERNET_KEY

BOOTSTRAP_ADMIN_EMAIL=alex@example.com
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_AT_LEAST_14_CHARACTERS
BOOTSTRAP_ADMIN_NAME=Alex

# Automatic SimpleFIN polling. 8 routine polls/day leaves room under the Bridge's 24/day guidance.
SIMPLEFIN_SYNC_INTERVAL_MINUTES=180
SIMPLEFIN_ROUTINE_DAYS=7
SIMPLEFIN_DEEP_DAYS=90
SIMPLEFIN_MAX_REQUESTS_24H=20

# SMTP2GO example: mail.smtp2go.com:587 with STARTTLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=
SMTP_STARTTLS=true
SMTP_SSL=false

# ntfy. Use a private, hard-to-guess topic and preferably an access token.
NTFY_URL=https://ntfy.sh
NTFY_TOPIC=
NTFY_TOKEN=

# Optional independent dead-man endpoint such as Healthchecks.io or Uptime Kuma push URL.
EXTERNAL_HEARTBEAT_URL=

# Mount this to storage outside the Docker host for genuine off-host backups.
BACKUP_PATH=./backups
BACKUP_RETENTION_DAYS=35
BACKUP_INTERVAL_SECONDS=86400
BACKUP_STALE_HOURS=36
